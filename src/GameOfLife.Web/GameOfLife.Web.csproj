<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameOfLife.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameOfLife\GameOfLife.csproj" />
    <PackageReference Include="AppMare.MauiWeb" Version="1.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's fonts, images and raw files, served from Resources/ (each app head packs them its own way). -->
    <None Include="..\GameOfLife\Resources\**" CopyToOutputDirectory="PreserveNewest" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keeps XAML and bindings working in a NativeAOT publish (dotnet publish -p:PublishAot=true). -->
    <TrimmerRootAssembly Include="Microsoft.Maui.Controls" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Controls.Xaml" />
    <TrimmerRootAssembly Include="Microsoft.Maui" />
    <TrimmerRootAssembly Include="MauiWeb" />
    <TrimmerRootAssembly Include="MauiWeb.Controls" />
    <TrimmerRootAssembly Include="GameOfLife" />
  </ItemGroup>

</Project>
